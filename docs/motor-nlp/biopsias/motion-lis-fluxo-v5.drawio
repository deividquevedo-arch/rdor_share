    <diagram id="motion-lis-fluxo" name="Motion LIS — fluxo">
        <mxGraphModel dx="1234" dy="1129" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="760" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="tit" value="&lt;b&gt;Motion LIS → captação: como o dado chega e como pode ser usado&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;anatomopatológico (AP) · v5 · medições de 29–30/10/2026, só agregados&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#111111;fontSize=18;" parent="1" vertex="1">
                    <mxGeometry x="40" y="20" width="900" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="f1" value="&lt;b&gt;1. COMO O DADO CHEGA HOJE&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#111111;fontSize=12;fontColor=#1F4E9A;" parent="1" vertex="1">
                    <mxGeometry x="40" y="85" width="400" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="lab" value="&lt;b&gt;Laboratório&lt;/b&gt;&lt;br&gt;Motion LIS&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;o patologista analisa o tecido e libera o laudo ~5 dias após a coleta&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#444444;strokeWidth=2;fontColor=#111111;fontSize=12;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="115" width="180" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="motion" value="&lt;b&gt;Tabela do Motion&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;especialistas.gold.tbl_motionlis_…_observation_exame&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;uma linha por campo do laudo; traz a &lt;b&gt;categoria&lt;/b&gt; (é câncer?) e o &lt;b&gt;material&lt;/b&gt; (de que órgão)&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#8A5A00'&gt;&lt;b&gt;⚠ não tem a unidade&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#1F4E9A;strokeWidth=2;fontColor=#111111;fontSize=12;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="340" y="115" width="240" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="fhir" value="&lt;b&gt;Tabela de pedidos (FHIR)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;gold_corporativo.observation.tb_gold_mov_observation_exames&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;o pedido no sistema do hospital (TASY, WPD, MV Soul); traz &lt;b&gt;unidade&lt;/b&gt; e paciente&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#8A5A00'&gt;&lt;b&gt;⚠ local anatômico vazio&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#1F4E9A;strokeWidth=2;fontColor=#111111;fontSize=12;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="700" y="115" width="240" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="gold" value="&lt;b&gt;Gold de exames&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;gold_corporativo_ia.corporativo.tb_gold_mov_exame&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;a base que os algoritmos de captação já usam; traz unidade, paciente e atendimento&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F5EA;strokeColor=#1E7B34;strokeWidth=2;fontColor=#111111;fontSize=12;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="115" width="240" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="proc" value="&lt;b&gt;Procedimento de origem&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;o exame em que a amostra foi colhida: colonoscopia, endoscopia, biópsia guiada&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;~52% dos AP não têm esse exame na base (cirurgia, consultório)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F5EA;strokeColor=#1E7B34;strokeWidth=2;fontColor=#111111;fontSize=12;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
