                <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4E9A;strokeWidth=2.5;fontColor=#111111;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="regra" target="tabia" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="glos" value="&lt;b&gt;Glossário&lt;/b&gt;&lt;br&gt;&lt;b&gt;AP (anatomopatológico)&lt;/b&gt; — exame que analisa o tecido retirado na biópsia ou na cirurgia.&lt;br&gt;&lt;b&gt;pedido + item&lt;/b&gt; — número que identifica o exame pedido; é a chave que liga uma tabela à outra.&lt;br&gt;&lt;b&gt;atendimento&lt;/b&gt; — a passagem do paciente pelo hospital (consulta, exame ou internação).&lt;br&gt;&lt;b&gt;“~95% casam”&lt;/b&gt; — de cada 100 resultados, ~95 encontram o registro correspondente na outra tabela.&lt;br&gt;&lt;b&gt;categoria (codificação da doença)&lt;/b&gt; — classificação preenchida pelo laboratório.&lt;br&gt;&lt;b&gt;material&lt;/b&gt; — texto curto que diz de onde veio a amostra (ex.: “biópsia gástrica”)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=2;fontColor=#111111;fontSize=12;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;align=left;spacingLeft=10;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="560" width="760" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="leg" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;font color='#1F4E9A'&gt;■&lt;/font&gt; tabela de origem do dado&lt;br&gt;&lt;font color='#1E7B34'&gt;■&lt;/font&gt; base ou exame que a captação já usa&lt;br&gt;&lt;font color='#5B2C83'&gt;■&lt;/font&gt; regra proposta&lt;br&gt;&lt;font color='#8A5A00'&gt;&lt;b&gt;⚠&lt;/b&gt;&lt;/font&gt; limitação do dado&lt;br&gt;&lt;b&gt;→&lt;/b&gt; seta contínua: ligação que existe hoje&lt;br&gt;&lt;b&gt;⇢&lt;/b&gt; seta tracejada: proposta / a definir" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;strokeWidth=2;fontColor=#111111;fontSize=12;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;align=left;spacingLeft=10;fontSize=11;" parent="1" vertex="1">
