                <mxCell id="e1" value="integração" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4E9A;strokeWidth=2.5;fontColor=#111111;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="lab" target="motion" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="&lt;b&gt;pedido + item&lt;/b&gt;&lt;br&gt;~95% casam" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4E9A;strokeWidth=2.5;fontColor=#111111;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="motion" target="fhir" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="&lt;b&gt;nº do pedido&lt;/b&gt;&lt;br&gt;~90% casam" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4E9A;strokeWidth=2.5;fontColor=#111111;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="fhir" target="gold" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="&lt;b&gt;mesmo atendimento&lt;/b&gt;&lt;br&gt;~36% dos AP&lt;br&gt;unidade igual em 100%" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4E9A;strokeWidth=2.5;fontColor=#111111;fontSize=10;labelBackgroundColor=#FFFFFF;" parent="1" source="gold" target="proc" edge="1">
