                <mxCell id="e5" value="categoria + material" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#1F4E9A;strokeWidth=2.5;fontColor=#111111;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" parent="1" source="motion" target="regra" edge="1">
