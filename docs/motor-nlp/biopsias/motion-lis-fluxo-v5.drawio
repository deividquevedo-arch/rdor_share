                <mxCell id="regra" value="&lt;b&gt;Regra estruturada (opção A)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;categoria = &lt;i&gt;neoplasia maligna primária&lt;/i&gt;, pré-neoplásica, in situ…&lt;br&gt;+ órgão pelo texto do material (lista de termos, 78% classificados)&lt;br&gt;&lt;b&gt;~1,6 mil câncer primário por mês&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3ECF8;strokeColor=#5B2C83;strokeWidth=2;fontColor=#111111;fontSize=12;verticalAlign=top;spacingTop=8;spacingLeft=6;spacingRight=6;" parent="1" vertex="1">
                    <mxGeometry x="340" y="380" width="600" height="115" as="geometry"/>
                </mxCell>
