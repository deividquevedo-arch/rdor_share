                <mxCell id="f2" value="&lt;b&gt;2. USO PROPOSTO&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#111111;fontSize=12;fontColor=#5B2C83;" parent="1" vertex="1">
