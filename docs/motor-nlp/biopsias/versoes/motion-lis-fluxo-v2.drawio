                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="&lt;b&gt;pedido + item&lt;/b&gt;&lt;br&gt;~95% casam" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;labelBackgroundColor=#ffffff;" parent="1" source="motion" target="fhir" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="&lt;b&gt;num_pedido_integracao&lt;/b&gt;&lt;br&gt;~90% casam (Motion → gold)" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;labelBackgroundColor=#ffffff;" parent="1" source="fhir" target="gold" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="nota_unidade" value="⚠️ &lt;b&gt;Sem unidade na tabela do Motion&lt;/b&gt;&lt;br&gt;a unidade vem do cruzamento com a tabela de pedidos ou com a gold; pedido sem par fica sem unidade" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="290" y="270" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="nota_bodysite" value="⚠️ &lt;b&gt;bodySite vazio&lt;/b&gt;&lt;br&gt;o campo de local anatômico vem em branco; o órgão sai do texto do &lt;i&gt;material&lt;/i&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="660" y="270" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="regra" value="&lt;b&gt;Regra estruturada (opção A)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;codificação da doença = &lt;i&gt;neoplasia maligna primária&lt;/i&gt;, pré-neoplásica, in situ…&lt;br&gt;+ órgão pelo texto do material (lista de termos, 78%)&lt;br&gt;&lt;b&gt;~1,6 mil câncer primário / mês&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="470" y="460" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="linhas" value="&lt;b&gt;Linhas de captação&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;próstata · mama · útero/colo · cólon · estômago…&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="485" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="tabia" value="&lt;b&gt;Tábia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;formato de entrega a definir&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="560" width="240" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="categoria + material" style="endArrow=block;html=1;rounded=0;fontSize=10;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" parent="1" source="motion" target="regra" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="paciente e unidade" style="endArrow=block;html=1;rounded=0;fontSize=10;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" parent="1" source="gold" target="regra" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1310" y="155"/>
                            <mxPoint x="1310" y="450"/>
                            <mxPoint x="793" y="450"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e6" style="endArrow=block;html=1;rounded=0;strokeWidth=2;" parent="1" source="regra" target="linhas" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e7" style="endArrow=block;html=1;rounded=0;dashed=1;" parent="1" source="regra" target="tabia" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="proc" value="&lt;b&gt;Procedimento de origem&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;colonoscopia · endoscopia · biópsia/punção guiada&lt;br&gt;(outro exame na gold de exames)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="270" width="260" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="e8" value="&lt;b&gt;mesmo atendimento&lt;/b&gt;&lt;br&gt;(id_encounter + paciente)&lt;br&gt;~36% dos AP · unidade igual em 100%" style="endArrow=block;html=1;rounded=0;fontSize=10;strokeWidth=2;labelBackgroundColor=#ffffff;" parent="1" source="gold" target="proc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="d_lab" value="&lt;b&gt;O que acontece aqui&lt;/b&gt;&lt;br&gt;o patologista analisa o material da biópsia e libera o laudo (AP)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="40" y="240" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="d_motion" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;cada laudo vira várias linhas — uma por campo (material, conclusão, categoria). A &lt;i&gt;categoria&lt;/i&gt; já diz se é câncer." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="290" y="360" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="d_fhir" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;é o pedido do exame no sistema do hospital. É daqui que vem a &lt;i&gt;unidade&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="660" y="360" width="260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="d_proc" value="&lt;b&gt;Como ler&lt;/b&gt;&lt;br&gt;é o exame em que a amostra foi colhida. Os ~52% sem ligação são, em geral, biópsias de cirurgia ou consultório." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="370" width="260" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="glossario" value="&lt;b&gt;Glossário&lt;/b&gt;&lt;br&gt;&lt;b&gt;AP (anatomopatológico):&lt;/b&gt; exame do laboratório que analisa o tecido retirado na biópsia.&lt;br&gt;&lt;b&gt;Pedido + item:&lt;/b&gt; número que identifica o exame pedido; é a 'chave' que liga uma tabela à outra.&lt;br&gt;&lt;b&gt;Atendimento:&lt;/b&gt; a passagem do paciente pelo hospital (consulta, exame ou internação).&lt;br&gt;&lt;b&gt;“~95% casam”:&lt;/b&gt; de cada 100 resultados, cerca de 95 encontram o pedido correspondente na outra tabela.&lt;br&gt;&lt;b&gt;Codificação da doença:&lt;/b&gt; categoria preenchida pelo laboratório (ex.: neoplasia maligna primária, pré-neoplásica).&lt;br&gt;&lt;b&gt;Material:&lt;/b&gt; texto curto que diz de onde veio a amostra (ex.: “biópsia gástrica”) — é dele que sai o órgão.&lt;br&gt;&lt;b&gt;Gold de exames:&lt;/b&gt; base de exames que os algoritmos de captação já usam." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="40" y="590" width="620" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="legenda2" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;font color='#6c8ebf'&gt;■&lt;/font&gt; tabela de origem do dado&lt;br&gt;&lt;font color='#82b366'&gt;■&lt;/font&gt; base ou exame que a captação já usa&lt;br&gt;&lt;font color='#9673a6'&gt;■&lt;/font&gt; regra proposta&lt;br&gt;&lt;font color='#d6b656'&gt;■&lt;/font&gt; alerta (limitação do dado)&lt;br&gt;□ explicação da etapa&lt;br&gt;━ seta contínua: ligação que existe hoje&lt;br&gt;┅ seta tracejada: proposta ou a definir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bbbbbb;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="700" y="590" width="300" height="150" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>