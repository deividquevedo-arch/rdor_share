                    <mxGeometry x="660" y="110" width="260" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="gold" value="&lt;b&gt;Gold de exames&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gold_corporativo_ia.corporativo.&lt;br&gt;tb_gold_mov_exame&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;base que a captação já lê&lt;br&gt;&lt;b&gt;unidade&lt;/b&gt; · paciente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="90" width="260" height="130" as="geometry"/>
