{
 "datasets": [
  {
   "name": "atencao",
   "displayName": "Atenção diária",
   "queryLines": [
    "WITH log AS (SELECT * FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_log WHERE tp_ambiente = 'prd'),\n",
    "ativas AS (SELECT nm_especialidade AS linha, min(to_date(dt_execucao_modelo)) AS ini FROM log GROUP BY 1),\n",
    "dias AS (\n",
    "  SELECT linha, dia FROM (SELECT linha, explode(sequence(ini, current_date())) AS dia FROM ativas)\n",
    "  WHERE dayofweek(dia) BETWEEN 2 AND 6\n",
    "),\n",
    "rel AS (\n",
    "  SELECT nm_especialidade AS linha, to_date(dt_execucao_modelo) AS dia,\n",
    "         max_by(st_execucao, dh_registro) AS st,\n",
    "         max_by(coalesce(ds_etapas_falha, ''), dh_registro) AS falhas,\n",
    "         max_by(qt_exportados, dh_registro) AS exportados,\n",
    "         max_by(qt_controle, dh_registro) AS controle,\n",
    "         max_by(qt_intervencao, dh_registro) AS navegacao,\n",
    "         max_by(qt_sem_chave, dh_registro) AS sem_cpf\n",
    "  FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_relatorio WHERE tp_ambiente = 'prd' GROUP BY 1, 2\n",
    "),\n",
    "lg AS (\n",
    "  SELECT nm_especialidade AS linha, to_date(dt_execucao_modelo) AS dia, count(*) AS registros,\n",
    "         sum(CASE WHEN tp_grupo = 'controle' AND fl_enviado THEN 1 ELSE 0 END) AS controle_enviado\n",
    "  FROM log GROUP BY 1, 2\n",
    "),\n",
    "base AS (\n",
    "  SELECT d.linha, d.dia, r.st, r.falhas, r.exportados, r.controle, r.navegacao, r.sem_cpf,\n",
    "         l.registros, coalesce(l.controle_enviado, 0) AS controle_enviado,\n",
    "         CASE WHEN r.linha IS NULL THEN 1 ELSE 0 END AS chk_sem_execucao,\n",
    "         CASE WHEN r.st <> 'SUCESSO' OR r.falhas <> '' THEN 1 ELSE 0 END AS chk_falha,\n",
    "         CASE WHEN r.exportados <> coalesce(r.controle,0) + coalesce(r.navegacao,0) + coalesce(r.sem_cpf,0) THEN 1 ELSE 0 END AS chk_conservacao,\n",
    "         CASE WHEN coalesce(l.registros,0) <> coalesce(r.controle,0) + coalesce(r.navegacao,0) THEN 1 ELSE 0 END AS chk_log_x_relatorio,\n",
    "         CASE WHEN coalesce(l.controle_enviado,0) > 0 THEN 1 ELSE 0 END AS chk_controle_enviado\n",
    "  FROM dias d LEFT JOIN rel r ON r.linha = d.linha AND r.dia = d.dia\n",
    "              LEFT JOIN lg l ON l.linha = d.linha AND l.dia = d.dia\n",
    ")\n",
    "SELECT *,\n",
    "  CASE WHEN chk_sem_execucao = 1 AND dia = current_date() THEN 'PENDENTE'\n",
    "       WHEN chk_sem_execucao + chk_falha + chk_conservacao + chk_log_x_relatorio + chk_controle_enviado > 0 THEN 'ALERTA'\n",
    "       ELSE 'OK' END AS status,\n",
    "  CASE WHEN NOT (chk_sem_execucao = 1 AND dia = current_date())\n",
    "        AND chk_sem_execucao + chk_falha + chk_conservacao + chk_log_x_relatorio + chk_controle_enviado > 0\n",
    "       THEN 1 ELSE 0 END AS fl_alerta\n",
    "FROM base\n"
   ]
  },
  {
   "name": "proporcao",
   "displayName": "Proporção acumulada",
   "queryLines": [
    "WITH b AS (SELECT avg(CASE WHEN tp_grupo = 'controle' THEN 1.0 ELSE 0.0 END) AS p FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_controle),\n",
    "pac AS (\n",
    "  SELECT nm_especialidade AS linha, num_cpf, max(tp_grupo) AS grupo\n",
    "  FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_log WHERE tp_ambiente = 'prd' GROUP BY 1, 2\n",
    "),\n",
    "agg AS (\n",
    "  SELECT linha, count(*) AS n, sum(CASE WHEN grupo = 'controle' THEN 1 ELSE 0 END) AS k FROM pac GROUP BY linha\n",
    "  UNION ALL\n",
    "  SELECT 'TOTAL', count(*), sum(CASE WHEN grupo = 'controle' THEN 1 ELSE 0 END) FROM pac\n",
    ")\n",
    "SELECT a.linha, a.n AS pacientes, a.k AS pacientes_controle,\n",
    "       round(a.k / a.n, 4) AS fracao_observada, round(b.p, 4) AS fracao_base,\n",
    "       round((a.k - a.n * b.p) / sqrt(a.n * b.p * (1 - b.p)), 2) AS z,\n",
    "       CASE WHEN abs((a.k - a.n * b.p) / sqrt(a.n * b.p * (1 - b.p))) > 3 THEN 'ALERTA' ELSE 'OK' END AS status\n",
    "FROM agg a CROSS JOIN b\n"
   ]
  },
  {
   "name": "integridade",
   "displayName": "Integridade",
   "queryLines": [
    "WITH l AS (SELECT * FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_log WHERE tp_ambiente = 'prd')\n",
    "SELECT\n",
    "  (SELECT count(*) FROM l) AS registros_total,\n",
    "  (SELECT count(*) FROM (SELECT num_cpf FROM l GROUP BY num_cpf HAVING count(DISTINCT tp_grupo) > 1)) AS cpf_com_dois_grupos,\n",
    "  (SELECT count(*) FROM l WHERE tp_grupo = 'controle' AND fl_enviado) AS controle_enviado,\n",
    "  (SELECT count(*) FROM l LEFT JOIN mlops_fabrica_ia.operacao.tb_mov_randomizacao_controle b\n",
    "     ON lpad(cast(l.num_cpf AS string), 11, '0') = lpad(cast(b.num_cpf AS string), 11, '0')\n",
    "   WHERE b.tp_grupo IS NULL OR b.tp_grupo <> l.tp_grupo) AS divergentes_da_base\n"
   ]
  },
  {
   "name": "grupos",
   "displayName": "Grupos por linha",
   "queryLines": [
    "SELECT nm_especialidade AS linha, tp_grupo AS grupo, count(*) AS exames, count(DISTINCT num_cpf) AS pacientes,\n",
    "       sum(CASE WHEN fl_enviado THEN 1 ELSE 0 END) AS exames_enviados,\n",
    "       min(to_date(dt_execucao_modelo)) AS primeiro_dia, max(to_date(dt_execucao_modelo)) AS ultimo_dia\n",
    "FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_log WHERE tp_ambiente = 'prd'\n",
    "GROUP BY 1, 2\n"
   ]
  },
  {
   "name": "funil",
   "displayName": "Funil por linha e dia",
   "queryLines": [
    "SELECT nm_especialidade AS linha, to_date(dt_execucao_modelo) AS dia,\n",
    "       max_by(qt_entrada, dh_registro) AS exames_entrada,\n",
    "       max_by(qt_saida, dh_registro) AS exames_processados,\n",
    "       max_by(qt_relevantes, dh_registro) AS exames_relevantes,\n",
    "       max_by(qt_exportados, dh_registro) AS exames_elegiveis_envio,\n",
    "       max_by(qt_controle, dh_registro) AS exames_controle,\n",
    "       max_by(qt_intervencao, dh_registro) AS exames_navegacao,\n",
    "       max_by(qt_sem_chave, dh_registro) AS exames_sem_cpf\n",
    "FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_relatorio WHERE tp_ambiente = 'prd'\n",
    "GROUP BY 1, 2\n"
   ]
  },
  {
   "name": "contaminacao",
   "displayName": "Contaminação",
   "queryLines": [
    "WITH g AS (\n",
    "  SELECT nm_especialidade AS linha, tp_grupo AS grupo, cast(id_paciente AS string) AS idp,\n",
    "         min(to_date(dt_execucao_modelo)) AS dt_rand\n",
    "  FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_log WHERE tp_ambiente = 'prd' GROUP BY 1, 2, 3\n",
    "),\n",
    "rel AS (\n",
    "  SELECT 'ateromatose_coronariana' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.ateromatose_coronariana.tb_mod_diamond_ateromatose_coronariana_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'cancer_colon' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.cancer_colon.tb_mod_diamond_cancer_colon_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'cancer_estomago' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.cancer_estomago.tb_mod_diamond_cancer_estomago_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'cancer_rim' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.cancer_rim.tb_mod_diamond_cancer_rim_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'doenca_inflamatoria_intestinal' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.doenca_inflamatoria_intestinal.tb_mod_diamond_doenca_inflamatoria_intestinal_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'doencas_biliares' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.doencas_biliares.tb_mod_diamond_doencas_biliares_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'hepatologia' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.hepatologia.tb_mod_diamond_hepatologia_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'neuroimunologia' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.neuroimunologia.tb_mod_diamond_neuroimunologia_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'pirads' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.pirads.tb_mod_diamond_pirads_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'transplante_pulmao' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.transplante_pulmao.tb_mod_diamond_transplante_pulmao_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'tumor_osseo' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.tumor_osseo.tb_mod_diamond_tumor_osseo_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'reumatologia' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.reumatologia.tb_mod_diamond_reumatologia_saida_v0 WHERE fl_relevante = 1\n",
    "  UNION ALL SELECT 'tirads' AS linha, cast(id_paciente AS string) AS idp, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.tirads.tb_mod_diamond_tirads_saida_v0 WHERE fl_relevante = 1\n",
    ")\n",
    "SELECT g.linha, g.grupo, count(DISTINCT g.idp) AS pacientes_randomizados,\n",
    "       count(DISTINCT CASE WHEN r.linha IS NOT NULL THEN g.idp END) AS relevantes_em_outra_linha\n",
    "FROM g LEFT JOIN rel r ON r.idp = g.idp AND r.linha <> g.linha AND r.dia >= g.dt_rand\n",
    "GROUP BY 1, 2\n"
   ]
  },
  {
   "name": "vg_resumo",
   "displayName": "Visão geral — resumo por linha",
   "queryLines": [
    "WITH ini AS (\n",
    "  SELECT nm_especialidade AS linha, min(to_date(dt_execucao_modelo)) AS d0\n",
    "  FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_log WHERE tp_ambiente = 'prd' GROUP BY 1\n",
    "),\n",
    "s AS (\n",
    "  SELECT 'ateromatose_coronariana' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.ateromatose_coronariana.tb_mod_diamond_ateromatose_coronariana_saida_v0\n",
    "  UNION ALL SELECT 'cancer_colon' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.cancer_colon.tb_mod_diamond_cancer_colon_saida_v0\n",
    "  UNION ALL SELECT 'cancer_estomago' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.cancer_estomago.tb_mod_diamond_cancer_estomago_saida_v0\n",
    "  UNION ALL SELECT 'cancer_rim' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.cancer_rim.tb_mod_diamond_cancer_rim_saida_v0\n",
    "  UNION ALL SELECT 'doenca_inflamatoria_intestinal' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.doenca_inflamatoria_intestinal.tb_mod_diamond_doenca_inflamatoria_intestinal_saida_v0\n",
    "  UNION ALL SELECT 'doencas_biliares' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.doencas_biliares.tb_mod_diamond_doencas_biliares_saida_v0\n",
    "  UNION ALL SELECT 'hepatologia' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.hepatologia.tb_mod_diamond_hepatologia_saida_v0\n",
    "  UNION ALL SELECT 'neuroimunologia' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.neuroimunologia.tb_mod_diamond_neuroimunologia_saida_v0\n",
    "  UNION ALL SELECT 'pirads' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.pirads.tb_mod_diamond_pirads_saida_v0\n",
    "  UNION ALL SELECT 'transplante_pulmao' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.transplante_pulmao.tb_mod_diamond_transplante_pulmao_saida_v0\n",
    "  UNION ALL SELECT 'tumor_osseo' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.tumor_osseo.tb_mod_diamond_tumor_osseo_saida_v0\n",
    "  UNION ALL SELECT 'reumatologia' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.reumatologia.tb_mod_diamond_reumatologia_saida_v0\n",
    "  UNION ALL SELECT 'tirads' AS linha, cast(id_paciente AS string) AS idp, fl_relevante, to_date(dt_execucao_modelo) AS dia FROM diamond_fabrica_ia.tirads.tb_mod_diamond_tirads_saida_v0\n",
    "),\n",
    "proc AS (\n",
    "  SELECT s.linha, count(DISTINCT s.idp) AS analisados,\n",
    "         count(DISTINCT CASE WHEN s.fl_relevante = 1 THEN s.idp END) AS relevantes\n",
    "  FROM s JOIN ini i ON i.linha = s.linha AND s.dia >= i.d0 GROUP BY 1\n",
    "),\n",
    "g AS (\n",
    "  SELECT nm_especialidade AS linha, count(DISTINCT num_cpf) AS randomizados,\n",
    "         count(DISTINCT CASE WHEN tp_grupo = 'controle' THEN num_cpf END) AS controle,\n",
    "         count(DISTINCT CASE WHEN tp_grupo = 'intervencao' THEN num_cpf END) AS navegacao\n",
    "  FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_log WHERE tp_ambiente = 'prd' GROUP BY 1\n",
    ")\n",
    "SELECT p.linha, i.d0 AS inicio, p.analisados, p.relevantes, g.randomizados, g.controle, g.navegacao,\n",
    "       round(100.0 * g.controle / g.randomizados, 1) AS pct_controle\n",
    "FROM proc p JOIN g ON g.linha = p.linha JOIN ini i ON i.linha = p.linha\n"
   ]
  },
  {
   "name": "vg_grupos",
   "displayName": "Visão geral — grupos por linha",
   "queryLines": [
    "SELECT nm_especialidade AS linha,\n",
    "       CASE WHEN tp_grupo = 'controle' THEN 'Controle' ELSE 'Navegação' END AS grupo,\n",
    "       count(DISTINCT num_cpf) AS pacientes\n",
    "FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_log WHERE tp_ambiente = 'prd'\n",
    "GROUP BY 1, 2\n"
   ]
  },
  {
   "name": "vg_dia",
   "displayName": "Visão geral — grupos por dia",
   "queryLines": [
    "SELECT nm_especialidade AS linha, to_date(dt_execucao_modelo) AS dia,\n",
    "       CASE WHEN tp_grupo = 'controle' THEN 'Controle' ELSE 'Navegação' END AS grupo,\n",
    "       count(DISTINCT num_cpf) AS pacientes\n",
    "FROM mlops_fabrica_ia.operacao.tb_mov_randomizacao_log WHERE tp_ambiente = 'prd'\n",
    "GROUP BY 1, 2, 3\n"
   ]
  }
 ],
