{
 "datasets": [
  {
   "name": "pacientes",
   "displayName": "Pacientes sorteados (paciente × janela) — SIMULADO",
   "queryLines": [
    "WITH b AS (WITH ids AS (\n",
    "  SELECT id,\n",
    "         CASE WHEN id < 2780 THEN 'Reumatologia' ELSE 'Tireoide' END AS linha,\n",
    "         CASE WHEN (id < 2780 AND id < 280) OR (id >= 2780 AND id - 2780 < 1020) THEN 'Controle' ELSE 'Navegação' END AS grupo\n",
    "  FROM range(0, 13000, 1, 1)\n",
    "),\n",
    "par AS (\n",
    "  SELECT ids.*,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 0.0045 ELSE 0.0060 END AS taxa,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1100.0 ELSE 780.0 END AS mediana,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1.40 ELSE 1.35 END AS ef_taxa,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1.15 ELSE 1.12 END AS ef_valor,\n",
    "         rand(101) AS u1, randn(202) AS z1, rand(303) AS u2\n",
    "  FROM ids\n",
    "),\n",
    "pac AS (\n",
    "  SELECT id, linha, grupo,\n",
    "         -ln(1 - u1) / (taxa * CASE WHEN grupo = 'Navegação' THEN ef_taxa ELSE 1 END) AS t,\n",
    "         mediana * CASE WHEN grupo = 'Navegação' THEN ef_valor ELSE 1 END * exp(z1) AS base,\n",
    "         0.35 + 0.65 * u2 AS ritmo\n",
    "  FROM par\n",
    ")\n",
    "SELECT id, linha, grupo, j.janela,\n",
    "       CASE WHEN t > j.janela THEN 0.0\n",
    "            ELSE base * least(1.0, (j.janela - t) / 90.0 * ritmo + 0.35) END AS valor,\n",
    "       t AS dias_ate_1o_consumo\n",
    "FROM pac CROSS JOIN (SELECT explode(array(30, 90, 180)) AS janela) j)\n",
    "SELECT linha, grupo, janela,\n",
    "       concat(cast(janela AS STRING), ' dias') AS janela_obs,\n",
    "       round(valor, 2) AS valor,\n",
    "       CASE WHEN valor > 0 THEN 1 ELSE 0 END AS consumiu,\n",
    "       CASE WHEN valor > 0 AND valor < 6000 THEN round(valor, 2) END AS consumo_se_voltou\n",
    "FROM b\n"
   ],
   "columns": [
    {
     "displayName": "Pacientes sorteados",
     "description": "Navegação + controle",
     "expression": "COUNT(`valor`)"
    },
    {
     "displayName": "Pacientes no controle",
     "description": "",
     "expression": "COUNT(CASE WHEN `grupo` = 'Controle' THEN 1 END)"
    },
    {
     "displayName": "Retorno — navegação",
     "description": "% que voltou a consumir",
     "expression": "AVG(CASE WHEN `grupo` = 'Navegação' THEN `consumiu` END)"
    },
    {
     "displayName": "Retorno — controle",
     "description": "% que voltou a consumir",
     "expression": "AVG(CASE WHEN `grupo` = 'Controle' THEN `consumiu` END)"
    },
    {
     "displayName": "Retorno a mais",
     "description": "Diferença em pontos percentuais",
     "expression": "AVG(CASE WHEN `grupo` = 'Navegação' THEN `consumiu` END) - AVG(CASE WHEN `grupo` = 'Controle' THEN `consumiu` END)"
    },
    {
     "displayName": "Consumo por paciente — navegação",
     "description": "Zero para quem não voltou",
     "expression": "AVG(CASE WHEN `grupo` = 'Navegação' THEN `valor` END)"
    },
    {
     "displayName": "Consumo por paciente — controle",
     "description": "Zero para quem não voltou",
     "expression": "AVG(CASE WHEN `grupo` = 'Controle' THEN `valor` END)"
    },
    {
     "displayName": "Uplift por paciente",
     "description": "Navegação − controle, por paciente sorteado",
     "expression": "(AVG(CASE WHEN `grupo` = 'Navegação' THEN `valor` END) - AVG(CASE WHEN `grupo` = 'Controle' THEN `valor` END))"
    },
    {
     "displayName": "Ganho sobre o controle",
     "description": "",
     "expression": "(AVG(CASE WHEN `grupo` = 'Navegação' THEN `valor` END) - AVG(CASE WHEN `grupo` = 'Controle' THEN `valor` END)) / AVG(CASE WHEN `grupo` = 'Controle' THEN `valor` END)"
    },
    {
     "displayName": "Uplift total no período",
     "description": "Uplift por paciente × pacientes navegados",
     "expression": "(AVG(CASE WHEN `grupo` = 'Navegação' THEN `valor` END) - AVG(CASE WHEN `grupo` = 'Controle' THEN `valor` END)) * COUNT(CASE WHEN `grupo` = 'Navegação' THEN 1 END)"
    }
   ]
  },
  {
   "name": "trajetoria",
   "displayName": "Trajetória semanal (grupo × linha × dia) — SIMULADO",
   "queryLines": [
    "WITH b AS (WITH ids AS (\n",
    "  SELECT id,\n",
    "         CASE WHEN id < 2780 THEN 'Reumatologia' ELSE 'Tireoide' END AS linha,\n",
    "         CASE WHEN (id < 2780 AND id < 280) OR (id >= 2780 AND id - 2780 < 1020) THEN 'Controle' ELSE 'Navegação' END AS grupo\n",
    "  FROM range(0, 13000, 1, 1)\n",
    "),\n",
    "par AS (\n",
    "  SELECT ids.*,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 0.0045 ELSE 0.0060 END AS taxa,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1100.0 ELSE 780.0 END AS mediana,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1.40 ELSE 1.35 END AS ef_taxa,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1.15 ELSE 1.12 END AS ef_valor,\n",
    "         rand(101) AS u1, randn(202) AS z1, rand(303) AS u2\n",
    "  FROM ids\n",
    "),\n",
    "pac AS (\n",
    "  SELECT id, linha, grupo,\n",
    "         -ln(1 - u1) / (taxa * CASE WHEN grupo = 'Navegação' THEN ef_taxa ELSE 1 END) AS t,\n",
    "         mediana * CASE WHEN grupo = 'Navegação' THEN ef_valor ELSE 1 END * exp(z1) AS base,\n",
    "         0.35 + 0.65 * u2 AS ritmo\n",
    "  FROM par\n",
    ")\n",
    "SELECT id, linha, grupo, j.janela,\n",
    "       CASE WHEN t > j.janela THEN 0.0\n",
    "            ELSE base * least(1.0, (j.janela - t) / 90.0 * ritmo + 0.35) END AS valor,\n",
    "       t AS dias_ate_1o_consumo\n",
    "FROM pac CROSS JOIN (SELECT explode(sequence(0, 182, 7)) AS janela) j)\n",
    "SELECT linha, grupo, janela AS dia,\n",
    "       count(*) AS n_pacientes,\n",
    "       sum(CASE WHEN valor > 0 THEN 1 ELSE 0 END) AS n_voltaram,\n",
    "       sum(valor) AS soma_consumo,\n",
    "       sum(CASE WHEN grupo = 'Navegação' THEN 1 ELSE 0 END) AS n_nav,\n",
    "       sum(CASE WHEN grupo = 'Navegação' THEN valor ELSE 0 END) AS soma_nav,\n",
    "       sum(CASE WHEN grupo = 'Controle' THEN 1 ELSE 0 END) AS n_ctrl,\n",
    "       sum(CASE WHEN grupo = 'Controle' THEN valor ELSE 0 END) AS soma_ctrl\n",
    "FROM b GROUP BY 1, 2, 3\n"
   ],
   "columns": [
    {
     "displayName": "% que já voltou",
     "description": "",
     "expression": "SUM(`n_voltaram`) / SUM(`n_pacientes`)"
    },
    {
     "displayName": "Consumo acumulado por paciente",
     "description": "",
     "expression": "SUM(`soma_consumo`) / SUM(`n_pacientes`)"
    },
    {
     "displayName": "Uplift acumulado por paciente",
     "description": "",
     "expression": "SUM(`soma_nav`) / SUM(`n_nav`) - SUM(`soma_ctrl`) / SUM(`n_ctrl`)"
    }
   ]
  },
  {
   "name": "distribuicao",
   "displayName": "Distribuição do consumo, 90 dias (grupo × linha × faixa) — SIMULADO",
   "queryLines": [
    "WITH b AS (WITH ids AS (\n",
    "  SELECT id,\n",
    "         CASE WHEN id < 2780 THEN 'Reumatologia' ELSE 'Tireoide' END AS linha,\n",
    "         CASE WHEN (id < 2780 AND id < 280) OR (id >= 2780 AND id - 2780 < 1020) THEN 'Controle' ELSE 'Navegação' END AS grupo\n",
    "  FROM range(0, 13000, 1, 1)\n",
    "),\n",
    "par AS (\n",
    "  SELECT ids.*,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 0.0045 ELSE 0.0060 END AS taxa,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1100.0 ELSE 780.0 END AS mediana,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1.40 ELSE 1.35 END AS ef_taxa,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1.15 ELSE 1.12 END AS ef_valor,\n",
    "         rand(101) AS u1, randn(202) AS z1, rand(303) AS u2\n",
    "  FROM ids\n",
    "),\n",
    "pac AS (\n",
    "  SELECT id, linha, grupo,\n",
    "         -ln(1 - u1) / (taxa * CASE WHEN grupo = 'Navegação' THEN ef_taxa ELSE 1 END) AS t,\n",
    "         mediana * CASE WHEN grupo = 'Navegação' THEN ef_valor ELSE 1 END * exp(z1) AS base,\n",
    "         0.35 + 0.65 * u2 AS ritmo\n",
    "  FROM par\n",
    ")\n",
    "SELECT id, linha, grupo, j.janela,\n",
    "       CASE WHEN t > j.janela THEN 0.0\n",
    "            ELSE base * least(1.0, (j.janela - t) / 90.0 * ritmo + 0.35) END AS valor,\n",
    "       t AS dias_ate_1o_consumo\n",
    "FROM pac CROSS JOIN (SELECT explode(array(30, 90, 180)) AS janela) j),\n",
    "v AS (SELECT linha, grupo, least(floor(valor / 100), 49) AS faixa FROM b WHERE janela = 90 AND valor > 0),\n",
    "grade AS (SELECT l.linha, l.grupo, f.faixa FROM (SELECT DISTINCT linha, grupo FROM v) l\n",
    "          CROSS JOIN (SELECT explode(sequence(0, 49)) AS faixa) f),\n",
    "c AS (SELECT g.linha, g.grupo, g.faixa, count(v.faixa) AS n\n",
    "      FROM grade g LEFT JOIN v ON v.linha = g.linha AND v.grupo = g.grupo AND v.faixa = g.faixa\n",
    "      GROUP BY 1, 2, 3),\n",
    "t AS (SELECT linha, grupo, count(*) AS n_total FROM v GROUP BY 1, 2)\n",
    "SELECT c.linha, c.grupo, c.faixa * 100 + 50 AS consumo_rs,\n",
    "       avg(c.n) OVER (PARTITION BY c.linha, c.grupo ORDER BY c.faixa ROWS BETWEEN 2 PRECEDING AND 2 FOLLOWING) AS n_suave,\n",
    "       t.n_total\n",
    "FROM c JOIN t ON t.linha = c.linha AND t.grupo = c.grupo\n"
   ],
   "columns": [
    {
     "displayName": "% do grupo",
     "description": "",
     "expression": "SUM(`n_suave`) / SUM(`n_total`)"
    }
   ]
  },
  {
   "name": "detalhe",
   "displayName": "Detalhe com intervalo de 95% (linha × janela) — SIMULADO",
   "queryLines": [
    "WITH b AS (WITH ids AS (\n",
    "  SELECT id,\n",
    "         CASE WHEN id < 2780 THEN 'Reumatologia' ELSE 'Tireoide' END AS linha,\n",
    "         CASE WHEN (id < 2780 AND id < 280) OR (id >= 2780 AND id - 2780 < 1020) THEN 'Controle' ELSE 'Navegação' END AS grupo\n",
    "  FROM range(0, 13000, 1, 1)\n",
    "),\n",
    "par AS (\n",
    "  SELECT ids.*,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 0.0045 ELSE 0.0060 END AS taxa,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1100.0 ELSE 780.0 END AS mediana,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1.40 ELSE 1.35 END AS ef_taxa,\n",
    "         CASE linha WHEN 'Reumatologia' THEN 1.15 ELSE 1.12 END AS ef_valor,\n",
    "         rand(101) AS u1, randn(202) AS z1, rand(303) AS u2\n",
    "  FROM ids\n",
    "),\n",
    "pac AS (\n",
    "  SELECT id, linha, grupo,\n",
    "         -ln(1 - u1) / (taxa * CASE WHEN grupo = 'Navegação' THEN ef_taxa ELSE 1 END) AS t,\n",
    "         mediana * CASE WHEN grupo = 'Navegação' THEN ef_valor ELSE 1 END * exp(z1) AS base,\n",
    "         0.35 + 0.65 * u2 AS ritmo\n",
    "  FROM par\n",
    ")\n",
    "SELECT id, linha, grupo, j.janela,\n",
    "       CASE WHEN t > j.janela THEN 0.0\n",
    "            ELSE base * least(1.0, (j.janela - t) / 90.0 * ritmo + 0.35) END AS valor,\n",
    "       t AS dias_ate_1o_consumo\n",
    "FROM pac CROSS JOIN (SELECT explode(array(30, 90, 180)) AS janela) j),\n",
    "g AS (\n",
    "  SELECT coalesce(linha, 'Onda 1 (somada)') AS linha, janela,\n",
    "         concat(cast(janela AS STRING), ' dias') AS janela_obs,\n",
    "         count(*) AS pacientes, count_if(grupo = 'Controle') AS no_controle,\n",
    "         avg(CASE WHEN grupo = 'Navegação' THEN CASE WHEN valor > 0 THEN 1.0 ELSE 0.0 END END) AS retorno_nav,\n",
    "         avg(CASE WHEN grupo = 'Controle' THEN CASE WHEN valor > 0 THEN 1.0 ELSE 0.0 END END) AS retorno_ctrl,\n",
    "         avg(CASE WHEN grupo = 'Navegação' THEN valor END) AS consumo_nav,\n",
    "         avg(CASE WHEN grupo = 'Controle' THEN valor END) AS consumo_ctrl,\n",
    "         sqrt(var_samp(CASE WHEN grupo = 'Navegação' THEN valor END) / count_if(grupo = 'Navegação')\n",
    "              + var_samp(CASE WHEN grupo = 'Controle' THEN valor END) / count_if(grupo = 'Controle')) AS ep\n",
    "  FROM b GROUP BY GROUPING SETS ((linha, janela), (janela))\n",
    ")\n",
    "SELECT linha, janela, janela_obs, pacientes, no_controle, retorno_nav, retorno_ctrl,\n",
    "       round(consumo_nav, 2) AS consumo_nav, round(consumo_ctrl, 2) AS consumo_ctrl,\n",
    "       round(consumo_nav - consumo_ctrl, 2) AS uplift,\n",
    "       round(consumo_nav - consumo_ctrl - 1.96 * ep, 2) AS limite_inferior,\n",
    "       round(consumo_nav - consumo_ctrl + 1.96 * ep, 2) AS limite_superior,\n",
    "       CASE WHEN consumo_nav - consumo_ctrl - 1.96 * ep > 0 THEN 'ganho claro' ELSE 'ainda não dá para afirmar' END AS leitura\n",
    "FROM g\n"
   ]
  }
 ],
